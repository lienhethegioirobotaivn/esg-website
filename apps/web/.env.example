GOOGLE_SHEET_QUESTIONS_ID=
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
SURVEY_REVALIDATE_SECONDS=300

# Công cụ dữ liệu thử bằng AI (chỉ bật trên máy cá nhân, KHÔNG bật trên production)
ENABLE_AI_TOOLS=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Thiết kế báo cáo theo bộ nhận diện thương hiệu bằng AI (tùy chọn)
# Dùng chung GEMINI_API_KEY. Khi tắt, API trả về 404 và giao diện không hiện.
ENABLE_BRAND_THEME=false
# Bỏ trống để dùng GEMINI_MODEL
GEMINI_BRAND_MODEL=
# Số lần phân tích bằng AI tối đa mỗi ngày (cả hệ thống) và mỗi 10 phút trên mỗi địa chỉ IP
BRAND_AI_DAILY_LIMIT=30
BRAND_AI_IP_LIMIT=5

# Địa chỉ API nội bộ mà trang quản trị (/quan-tri) gọi qua đường dẫn /api/v1. Được đọc khi build.
API_INTERNAL_URL=http://localhost:3001

# Khóa ký phiên xác nhận email của người dùng và mã liên kết báo cáo (tối thiểu 32 ký tự ngẫu nhiên). Để trống thì tính năng email OTP tắt.
USER_SESSION_SECRET=

# Địa chỉ website công khai (không có dấu / ở cuối), dùng cho SEO: sitemap, robots, canonical, ảnh chia sẻ
NEXT_PUBLIC_SITE_URL=

# Khóa bí mật cho endpoint tự động dịch /api/cron/translations (tối thiểu 16 ký tự, dùng chung với Apps Script hoặc Vercel Cron)
CRON_SECRET=
