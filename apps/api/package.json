{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:shared && nest build",
    "start": "pnpm build:shared && nest start",
    "start:dev": "pnpm build:shared && nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint",
    "typecheck": "pnpm build:shared && tsc --noEmit",
    "test": "pnpm build:shared && vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm build:shared && vitest run --config ./vitest.config.integration.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/database/migrate-cli.ts",
    "db:check": "drizzle-kit check",
    "build:shared": "pnpm --filter @esg/shared build",
    "question-bank:import": "pnpm build:shared && node --import tsx src/question-bank/import-cli.ts"
  },
  "dependencies": {
    "@esg/shared": "workspace:*",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "drizzle-orm": "0.45.4",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.16",
    "@nestjs/testing": "12.6.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^7.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
