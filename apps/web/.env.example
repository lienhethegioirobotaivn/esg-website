GOOGLE_SHEET_QUESTIONS_ID=
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
SURVEY_REVALIDATE_SECONDS=300

# Công cụ dữ liệu thử bằng AI (chỉ bật trên máy cá nhân, KHÔNG bật trên production)
ENABLE_AI_TOOLS=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Trang quản trị nội dung "Về ESG Report Online" (/quan-tri)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Địa chỉ website công khai (không có dấu / ở cuối), dùng cho SEO: sitemap, robots, canonical, ảnh chia sẻ
NEXT_PUBLIC_SITE_URL=

# Khóa bí mật cho endpoint tự động dịch /api/cron/translations (tối thiểu 16 ký tự, dùng chung với Apps Script hoặc Vercel Cron)
CRON_SECRET=
